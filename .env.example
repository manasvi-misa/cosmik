# Database
DATABASE_URL="postgresql://username:password@localhost:5432/cosmik"

# NextAuth
AUTH_SECRET="your-super-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your@email.com"
SMTP_PASS="your-app-password"
SMTP_FROM="Cosmik <noreply@cosmik.app>"

# OpenStreetMap / Nominatim (free, no key needed)
# Google Maps (optional, for enhanced autocomplete)
GOOGLE_MAPS_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Cosmik"
MAX_CHARTS_PER_USER=10
